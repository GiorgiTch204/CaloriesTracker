PORT=5000

# Any long random string — used to sign login sessions (JWT)
JWT_SECRET=change-this-to-a-long-random-string

# Optional: enables the "Sign in with Google" button.
# Create an OAuth Client ID (type: Web application) in Google Cloud Console
# and add your frontend URL (e.g. http://localhost:5173) under
# "Authorized JavaScript origins". Leave blank to disable Google sign-in —
# email/password login always works.
GOOGLE_CLIENT_ID=
